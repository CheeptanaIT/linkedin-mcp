# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (.env ถูก ignore โดย git)

# โทเค็นสำหรับเรียก Worker (ตั้งค่าไว้แล้วใน Cloudflare ด้วย wrangler secret)
MCP_TOKEN=

# URL ของ Worker (ไม่ต้องแก้ ถ้า deploy ตามปกติ)
LINKEDIN_MCP_URL=https://linkedin-mcp.cheeptana-boy.workers.dev

# LinkedIn Developer App (ขั้นที่ 0.5 ใช้ตอนถึงขั้นที่ 4)
# Redirect URL ต้องเป็น URL ของ Worker ไม่ใช่ localhost:
# https://linkedin-mcp.cheeptana-boy.workers.dev/oauth/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# เวอร์ชัน LinkedIn REST API (รูปแบบ YYYYMM)
LINKEDIN_API_VERSION=202601
